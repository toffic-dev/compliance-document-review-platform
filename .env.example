# Copy this file to .env and fill in real values.
# NEVER commit the real .env file - it's already in .gitignore.

# --- Database ---
POSTGRES_USER=compliance
POSTGRES_PASSWORD=compliance
POSTGRES_DB=compliance_review

# --- Third-party AI API (Gemini) ---
GEMINI_API_KEY=your-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# --- Backend ---
SESSION_SECRET=change-me
BACKEND_PORT=8000

# --- AI service ---
AI_PORT=8001

# --- Frontend (Next.js, deployed on Vercel, not run via docker-compose) ---
# Set this in Vercel's own environment variable config, not here.
# Documented for reference only.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Internal service auth ---
# Used by Data Engineering to call Backend's internal file-access endpoint
INTERNAL_SERVICE_TOKEN=change-me-shared-secret
